# Paste into the Dockge stack's .env editor (or copy to .env next to docker-compose.yml).

# Image tag. `phase-2` tracks the phase-2 branch; `latest` tracks main.
REPLAYARR_TAG=phase-2

# Login for the web UI (HTTP Basic).
REPLAYARR_USERNAME=admin
REPLAYARR_PASSWORD=

# Host folder that holds both your downloads and your media library,
# mounted into the container at /data.
DATA_ROOT=/srv/data

# Owner of the files under DATA_ROOT (run `id` on the host).
PUID=1000
PGID=1000

TZ=Europe/London

# Optional
# REPLAYARR_PORT=4173
# REPLAYARR_BIND_ADDRESS=0.0.0.0
# REPLAYARR_MEM_LIMIT=512m
